# Copy to .env.local (git-ignored) and fill in.

# Workbench host that fronts your organisation's SSO (OAuth + MCP gateway).
# Without it, sign-in and workbench features (apps, Jira, team hub) are off.
LEGOS_WORKBENCH_URL=https://workbench.example.com

# Shown on the sign-in button: "Sign in with <name>"
LEGOS_SSO_NAME=Example

# Optional
# LEGOS_AUTH=off                    # skip sign-in (local dev)
# LEGOS_HUB_URL=http://localhost:4400
# LEGOS_API_PORT=4317
