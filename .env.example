# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# sign-in is a local PIN, and workbench / MCP servers are set up in Settings → Connections.

# LEGOS_AUTH=off                    # skip the PIN screen (local dev)
# LEGOS_API_PORT=4317
# LEGOS_HUB_URL=http://localhost:4400

# Team hub process only (npm run hub): the workbench it verifies posters against
# LEGOS_WORKBENCH_URL=https://workbench.example.com
