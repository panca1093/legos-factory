# Copy to .env.local (git-ignored) and fill in. Everything here is optional:
# local users sign in with a PIN, and workbench / MCP servers are set up in Settings → Connections.

# LEGOS_AUTH=off                    # skip sign-in (local dev)
# LEGOS_API_PORT=4317
# LEGOS_HUB_URL=http://localhost:4400
# Team mode: a control plane that only coordinates, and runners that pull its jobs (README → Modes)
# LEGOS_RUNNER=off                   # on/off for the embedded runner; default off when LEGOS_BIND is not loopback or LEGOS_PUBLIC_URL is set
# LEGOS_BIND=0.0.0.0                 # default 127.0.0.1; put TLS in front when you bind wider
# LEGOS_PUBLIC_URL=https://factory.example.com
# LEGOS_CONTROL_URL=https://factory.example.com   # for `npm run runner`
# LEGOS_RUNNER_TOKEN=lfr_...                      # for `npm run runner`
# LEGOS_MAX_RUNS=3                   # runs at once per runner
# LEGOS_LEASE_MS=60000
# LEGOS_MAX_ATTEMPTS=3
# LEGOS_DB=~/.legos-factory/factory.db
# LEGOS_BITBUCKET_WORKSPACE=acme     # where New task lists repos from

# Sign in with any OpenID Connect issuer; register <LEGOS_PUBLIC_URL>/auth/oidc/callback as the redirect URI
# LEGOS_OIDC_ISSUER=https://login.example.com
# LEGOS_OIDC_CLIENT_ID=
# LEGOS_OIDC_CLIENT_SECRET=
# LEGOS_OIDC_NAME=Example SSO        # the button's text
# LEGOS_OIDC_ALLOWED_DOMAINS=example.com,example.org

# Adds "Sign in with workbench" next to the PIN users; the team hub (npm run hub) verifies posters against it too
# LEGOS_WORKBENCH_URL=https://workbench.example.com
