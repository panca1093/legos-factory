{
  "name": "legos-factory",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx --env-file-if-exists=.env.local watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env.local server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc",
    "dev:team": "concurrently -k -n hub,server,web \"LEGOS_MODE=hub tsx --env-file-if-exists=.env.local watch server/index.ts\" \"LEGOS_HUB_URL=http://localhost:4400 tsx --env-file-if-exists=.env.local watch server/index.ts\" \"vite\"",
    "hub": "LEGOS_MODE=hub tsx --env-file-if-exists=.env.local server/index.ts"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@hono/node-server": "^2.1.4",
    "dompurify": "3.4.16",
    "hono": "^4.13.13",
    "marked": "18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": true
}
